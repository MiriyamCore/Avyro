# Avyro production environment — copy to .env on the server.
#   cp .env.production.example .env
# Never commit .env. These hostnames (postgres, redis, api) are Docker Compose service names.

NODE_ENV=production

# Postgres (container). POSTGRES_* is used by the database container.
# DATABASE_URL is used by the API / migrate / seed. Host MUST be "postgres".
POSTGRES_USER=accounting
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=avyro
DATABASE_URL="postgresql://accounting:replace-with-a-long-random-password@postgres:5432/avyro?schema=public"

# Redis (container). Host MUST be "redis".
REDIS_URL="redis://redis:6379"

# Public URLs as the browser and payment gateways see them.
# MUST match how you actually open the app (http vs https, IP vs domain).
# First boot over IP:          http://YOUR.SERVER.IP
# After DNS + nginx HTTPS:     https://avyro.example.com
WEB_URL="http://YOUR.SERVER.IP"
BETTER_AUTH_URL="http://YOUR.SERVER.IP"
API_URL="http://YOUR.SERVER.IP"

# Internal rewrite target for Next.js → NestJS (do not change).
API_INTERNAL_URL="http://api:3001"
API_PORT="3001"

# Session signing secret — generate with:  openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Uploaded documents live in a Docker volume.
STORAGE_ROOT="/data/storage"

# nginx reverse proxy
# First deploy (HTTP / server IP):   NGINX_HOST=_
# After DNS A-record points here:    NGINX_HOST=avyro.example.com
# Then run: ./infra/scripts/deploy.sh --https
NGINX_HOST=_
ACME_EMAIL=admin@example.com

# Outbound email (optional — worker logs a stub when unset)
SMTP_HOST=
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SSLCommerz (optional)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
# SSLCOMMERZ_API_URL=https://securepay.sslcommerz.com/gwprocess/v4/api.php

# First-boot owner (used only with: ./infra/scripts/deploy.sh --seed)
# Do not use the local demo password. Do not re-run --seed on an existing database.
SEED_OWNER_EMAIL="you@example.com"
SEED_OWNER_PASSWORD="replace-with-a-strong-owner-password"
SEED_OWNER_NAME="Owner"
SEED_WORKSPACE_NAME="My Company"
SEED_WORKSPACE_SLUG="my-company"
SEED_ORG_NAME="My Company"
SEED_DEMO_DATA="false"
