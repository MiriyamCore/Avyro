# Avyro — environment template
# Copy to .env and adjust before running. Never commit .env to version control.
#
# BETA WARNING: Defaults below are for local development only.
# Generate a strong BETTER_AUTH_SECRET and change SEED_* credentials before
# any shared, staging, or production deployment.
# Production Docker: copy .env.production.example instead — see docs/DEPLOYMENT.md.

# Database
DATABASE_URL="postgresql://accounting:accounting@127.0.0.1:5432/avyro?schema=public"

# Redis (required for email queue / BullMQ worker)
REDIS_URL="redis://localhost:6379"

# Outbound email (optional — worker logs stub when unset)
SMTP_HOST=
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# bKash / Nagad adapter stubs (optional — not implemented in beta)
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=

# API
API_PORT="3001"
API_URL="http://127.0.0.1:3001"
# Docker production only — Next.js → API on the Compose network
# API_INTERNAL_URL="http://api:3001"
WEB_URL="http://localhost:3000"
BETTER_AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
# Public auth URL as seen in the browser (Next.js proxies /api → API)
BETTER_AUTH_URL="http://localhost:3000"

# Object storage — local filesystem by default; S3 when configured below
STORAGE_ROOT="./.data/storage"
BACKUP_ROOT="./.data/backups"

# S3 / R2 backups & file storage (optional — when set, backups upload to S3)
# S3_BUCKET=
# S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          # Cloudflare R2 / MinIO endpoint
# S3_FORCE_PATH_STYLE="true"

# Backup scheduler interval in ms (API checks due orgs; default 15 min)
# BACKUP_SCHEDULER_INTERVAL_MS=900000

# SSLCommerz sandbox (optional — hide SSLCommerz option when unset)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
# SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php

# Seed (local dev only — change before any shared environment)
SEED_OWNER_EMAIL="owner@demo.local"
SEED_OWNER_PASSWORD="ChangeMeNow1!"
SEED_OWNER_NAME="Demo Owner"

# Worker is not started by `pnpm dev`. Run separately:
#   pnpm --filter @avyro/worker dev
